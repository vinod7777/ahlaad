<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Don't rewrite actual files or directories (like assets, images, API requests)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Rewrite everything else to index.html for React Router SPA handling
  RewriteRule ^ index.html [QSA,L]
</IfModule>
